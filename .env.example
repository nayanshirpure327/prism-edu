# ============================================================
# PRISM-EDU — Environment Variables Template
# ============================================================
# Copy this file to .env.development / .env.test / .env.production
# NEVER commit actual secrets to version control.
# Production secrets must be managed via AWS Secrets Manager or
# equivalent secrets management service.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development                     # development | test | staging | production
APP_NAME=PRISM-EDU
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://prism_user:CHANGE_ME@localhost:5432/prism_edu
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false                     # Set true only in development for SQL logging

# ── Authentication ───────────────────────────────────────────
# Generate RSA key pair: openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_MAX_CONNECTIONS=20

# ── LLM / AI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL_PRIMARY=gpt-4o            # For complex reasoning (pathway, decision)
OPENAI_MODEL_SECONDARY=gpt-4o-mini    # For explanations, summaries
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_REQUEST_TIMEOUT_SECONDS=30
AI_RESPONSE_CACHE_TTL_SECONDS=3600    # Cache AI explanations for 1 hour

# ── Object Storage (MinIO for dev, S3 for production) ────────
S3_ENDPOINT_URL=http://localhost:9000  # Remove for AWS S3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=prism-edu-storage
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=prism-edu-public

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025                         # MailHog for development
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@prismedu.app
SMTP_FROM_NAME=PRISM-EDU
SMTP_USE_TLS=false                     # true for production
SMTP_USE_SSL=false

# ── CORS & Security ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
COOKIE_SECURE=false                    # true for production (requires HTTPS)
COOKIE_SAMESITE=lax                    # strict for production

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE_ANONYMOUS=30
RATE_LIMIT_PER_MINUTE_AUTHENTICATED=120
RATE_LIMIT_PER_MINUTE_AI_ENDPOINTS=20

# ── Background Workers (Celery) ───────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4
CELERY_TASK_SOFT_TIME_LIMIT=300       # 5 minutes soft limit
CELERY_TASK_TIME_LIMIT=600            # 10 minutes hard limit

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=                           # Leave empty for development
PROMETHEUS_ENABLED=false
METRICS_PORT=9090

# ── Feature Flags ────────────────────────────────────────────
FEATURE_AI_EXPLANATIONS=true
FEATURE_RAG_ENABLED=true
FEATURE_PARENT_ACCESS=true
FEATURE_COUNSELOR_WORKFLOWS=true
FEATURE_REPORT_GENERATION=true
FEATURE_SCHOLARSHIP_MATCHING=true

# ── Pagination Defaults ───────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Data Quality ──────────────────────────────────────────────
DATA_REVIEW_INTERVAL_DAYS=90          # Flag data for review after 90 days
DATA_EXPIRY_DAYS=365                  # Expire data after 1 year without verification
